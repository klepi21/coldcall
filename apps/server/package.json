{
  "name": "@coldcall/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "progress:check": "tsx --env-file=.env scripts/progress-check.ts",
    "admin:grant": "tsx --env-file=.env scripts/grant-admin.ts"
  },
  "devDependencies": {
    "@types/node": "22.16.5",
    "@types/pg": "8.15.4",
    "@types/ws": "8.18.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@coldcall/games": "workspace:*",
    "@coldcall/shared": "workspace:*",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.0.1",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/websocket": "11.1.0",
    "@mysten/sui": "2.39.1",
    "chess.js": "1.4.0",
    "fastify": "5.4.0",
    "pg": "8.16.3",
    "pino": "9.7.0",
    "pino-pretty": "13.0.0",
    "stockfish": "19.0.1",
    "ws": "8.18.3",
    "zod": "3.25.76"
  }
}
