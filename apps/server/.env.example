# Cold Call game server. Copy to .env (git ignored) and fill in. Never commit real keys.
DATABASE_URL=postgres://localhost:5432/coldcall_devnet
WEB_ORIGIN=http://localhost:3000
SUI_NETWORK=devnet
SUI_RPC=https://fullnode.devnet.sui.io:443
# Absolute path to the ids written by move/scripts/publish.sh
COLD_CALL_CONFIG=/path/to/coldcall/cold_call.config.json
# cc-game key (suiprivkey1...): gas sponsor and withdrawal ticket signer. From .secrets/devnet.env
CC_GAME_KEY=
# Google OAuth web client id (zkLogin). Leave empty to offer only the guest wallet.
GOOGLE_CLIENT_ID=
# Random secret for the stable zkLogin salt: openssl rand -hex 32. Never change it once users exist.
ZK_SALT_SECRET=
# Optional
# SUI_DRIP_BASE=500000000
# SUI_DRIP_HOURS=12
# SUI_DRIP_FLOOR_BASE=2000000000
# ADMIN_WALLETS=0x...
